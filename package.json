{
  "name": "@mukea/uiohook-napi",
  "version": "2.0.0-alpha1",
  "author": {
    "name": "mukea.cc"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mukea-org/uiohook-napi"
  },
  "license": "MIT",
  "keywords": [
    "iohook",
    "uiohook",
    "libuiohook",
    "hook",
    "input",
    "keyboard",
    "mouse"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "build": "pnpm build-ts",
    "build-ts": "node ./scripts/build-ts.mjs",
    "native:build": "node ./scripts/run-cmake-js.mjs build",
    "native:clean": "node ./scripts/run-cmake-js.mjs clean",
    "prebuild": "node ./scripts/build-prebuild.mjs",
    "prepublishOnly": "pnpm build-ts && node ./scripts/verify-prebuilds.mjs",
    "pack:local": "pnpm build-ts && pnpm prebuild && npm pack",
    "demo": "ts-node src/demo.ts",
    "demo:keys": "pnpm native:build && ts-node src/demo.ts",
    "sync:libuiohook": "powershell -ExecutionPolicy Bypass -File ./scripts/sync-upstream.ps1"
  },
  "files": [
    "dist",
    "prebuilds"
  ],
  "devDependencies": {
    "@types/node": "^20.11.30",
    "cmake-js": "^7.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "node-gyp-build": "4.x.x"
  },
  "engines": {
    "node": ">=20"
  },
  "binary": {
    "napi_versions": [
      8,
      9,
      10
    ]
  },
  "napi_versions": [
    8,
    9,
    10
  ]
}
